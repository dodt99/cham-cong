# Một origin duy nhất cho trình duyệt: /api/* → backend, còn lại → frontend.
# SITE_ADDRESS là tên miền (Caddy tự xin chứng chỉ HTTPS) hoặc ":80" khi chạy thử trong mạng nội bộ.
{$SITE_ADDRESS::80} {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}
}
